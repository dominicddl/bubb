# Supabase (local dev defaults from `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# AI (bubb-hosted — per D-05, never exposed to extension)
OPENAI_API_KEY=sk-your-openai-api-key

# CORS (update with your extension ID)
CORS_ORIGINS=["chrome-extension://your-extension-id"]

# Extension env vars (create extension/.env with these)
# WXT_SUPABASE_URL=http://127.0.0.1:54321
# WXT_SUPABASE_ANON_KEY=your-anon-key
