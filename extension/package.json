{
  "name": "bubb-extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts --project=e2e",
    "test:e2e:smoke": "playwright test --config=e2e/playwright.config.ts --project=smoke",
    "test:e2e:all": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.95.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.40",
    "lucide-react": "latest",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.38",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.8.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0",
    "wxt": "^0.20.20"
  }
}
